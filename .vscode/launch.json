{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug lem_in",
            "type": "cppdbg",
            "request": "launch",
            "program": "/bin/bash",
            "args": [
                "${workspaceFolder}/.vscode/debug.sh"
            ],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "/usr/bin/gdb",
            "preLaunchTask": "build",
            "setupCommands": [
                {
                    "description": "Activer le pretty printing de GDB",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ]
        }
    ]
}